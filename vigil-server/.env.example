# VigilOS V3 — Environment Variables
# Copy this file to .env and fill in the values

# ═══════════════════════════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════════════════════════

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/vigilos?schema=public"

# ═══════════════════════════════════════════════════════════════════════════════
# REDIS
# ═══════════════════════════════════════════════════════════════════════════════

# Redis connection string
REDIS_URL="redis://localhost:6379"

# ═══════════════════════════════════════════════════════════════════════════════
# JWT & AUTH
# ═══════════════════════════════════════════════════════════════════════════════

# JWT secret for signing tokens (min 32 characters)
JWT_SECRET="your-super-secret-jwt-key-min-32-characters-long"

# JWT token expiry (default: 15 minutes)
JWT_EXPIRES_IN="15m"

# Refresh token expiry in days (default: 7 days)
REFRESH_TOKEN_EXPIRY_DAYS="7"

# ═══════════════════════════════════════════════════════════════════════════════
# SERVER
# ═══════════════════════════════════════════════════════════════════════════════

# Server port
PORT="3000"

# Environment (development, production, test)
NODE_ENV="development"

# CORS allowed origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# ═══════════════════════════════════════════════════════════════════════════════
# INFLUXDB (Time Series Database)
# ═══════════════════════════════════════════════════════════════════════════════

INFLUXDB_URL="http://localhost:8086"
INFLUXDB_TOKEN="your-influxdb-token"
INFLUXDB_ORG="vigilos"
INFLUXDB_BUCKET="telemetry"

# ═══════════════════════════════════════════════════════════════════════════════
# MQTT (Message Broker)
# ═══════════════════════════════════════════════════════════════════════════════

MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_USERNAME=""
MQTT_PASSWORD=""

# ═══════════════════════════════════════════════════════════════════════════════
# FIREBASE (Push Notifications)
# ═══════════════════════════════════════════════════════════════════════════════

FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# ═══════════════════════════════════════════════════════════════════════════════
# RATE LIMITING
# ═══════════════════════════════════════════════════════════════════════════════

# Global rate limit (requests per minute)
GLOBAL_RATE_LIMIT="100"

# Per-tenant rate limit (requests per minute)
TENANT_RATE_LIMIT="1000"

# Login rate limit (attempts per 5 minutes)
LOGIN_RATE_LIMIT="5"

# ═══════════════════════════════════════════════════════════════════════════════
# DATA RETENTION (PRD §5.3)
# ═══════════════════════════════════════════════════════════════════════════════

# Retention period for cancelled tenants (days)
TENANT_RETENTION_DAYS="90"

# Cron schedule for data retention job (default: 2 AM daily)
DATA_RETENTION_CRON="0 2 * * *"
